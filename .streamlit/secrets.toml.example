# Modelo de conexão com o banco no Supabase (PostgreSQL)
# Copie para .streamlit/secrets.toml e use os dados do botão Connect > Session pooler do seu projeto

[connections.postgresql]
dialect = "postgresql"
driver = "psycopg"
host = "aws-X-sa-east-1.pooler.supabase.com"
port = 5432
database = "postgres"
username = "postgres.seu_project_ref"
password = "sua_senha_aqui"

[connections.postgresql.create_engine_kwargs]
pool_pre_ping = true
